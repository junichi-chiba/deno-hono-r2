{
  "tasks": {
    "dev": "deno run --watch --allow-env --allow-net src/index.ts",
    "start": "deno run --allow-env --allow-net src/index.ts",
    "check": "deno fmt --check && deno lint && deno check src/index.ts",
    "fmt": "deno fmt"
  },
  "imports": {
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.7.0",
    "hono": "npm:hono@^4.7.2",
    "s3": "npm:@aws-sdk/client-s3@^3.873.0",
    "presigner": "npm:@aws-sdk/s3-request-presigner@^3.873.0",
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "zod": "npm:zod@^4.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "jsx": "precompile",
    "jsxImportSource": "hono/jsx"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "ban-untagged-todo",
        "camelcase",
        "default-param-last",
        "eqeqeq",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "guard-for-in",
        "no-await-in-loop",
        "no-boolean-literal-for-arguments",
        "no-eval",
        "no-external-import",
        "no-fallthrough",
        "no-import-prefix",
        "no-inner-declarations",
        "no-node-globals",
        "no-process-global",
        "no-slow-types",
        "no-sync-fn-in-async-fn",
        "no-top-level-await",
        "no-unversioned-import",
        "prefer-ascii",
        "react-no-danger",
        "react-no-danger-with-children",
        "react-rules-of-hooks",
        "single-var-declarator",
        "verbatim-module-syntax"
      ]
    }
  }
}
